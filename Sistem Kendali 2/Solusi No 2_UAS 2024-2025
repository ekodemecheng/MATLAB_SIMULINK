% ANALYSIS
% System parameters
m = 2000; % (m)   vehicle mass in kg
b = 75;   % (b)   damping coefficient in N.s/m
u = 750;  % (u)   nominal control force in N

% Open-loop step response
s = tf('s');
P_cruise = 1/(m*s+b);

step(u*P_cruise)

>> % Open-loop poles/zeros
figure;
pzmap(P_cruise)
axis([-1 1 -1 1])

>> % Open-loop Bode plot
figure;
bode(P_cruise)

>> % PID Control
% Performance specifications:
% Rise time < 5 s
% Overshoot < 10%
% Steady-state error < 2%

% PID Parameters
Kp = 5000;   % Proportional gain
Ki = 200;    % Integral gain
Kd = 50;     % Derivative gain
C = pid(Kp);

T = feedback(C*P_cruise,1)

t = 0:0.1:20;
step(r*T,t)
axis([0 20 0 800])

stepinfo(T)

