%  Analisis stabilitas sistem loop tertutup (feedback)
% Define the transfer function
num = 1;
den = [2 5 1 2 0];
G = tf(num, den)

G =
 
              1
  -------------------------
  2 s^4 + 5 s^3 + s^2 + 2 s
 
Continuous-time transfer function.
Model Properties

>> % Pole-Zero Map
figure;
grid on
pzmap(G);
title('Pole-Zero Map');
>> 
% Menampilkan nilai poles 
>> pole(G)

ans =

   0.0000 + 0.0000i
